#!/usr/bin/env bash
set -Eeuo pipefail

cd /opt/lintex-login

echo "Pulling lintex-login image"
docker compose pull

echo "Updating lintex-login containers"
docker compose up -d --remove-orphans

echo "Checking lintex-login health"
curl --fail --silent --show-error --retry 10 --retry-delay 2 \
  http://127.0.0.1:3000/auth/login >/dev/null

echo "Deployment completed"

